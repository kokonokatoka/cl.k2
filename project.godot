; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text editor.

config_version=5

[application]

config/name="cl.k2"
config/description="C.K.1.2 - Swap-your-parts top-down robot action with server-authoritative online play (Godot 4 Web)"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Log="*res://src/core/log.gd"
Cfg="*res://src/core/app_config.gd"
Events="*res://src/core/events.gd"
I18n="*res://src/core/i18n.gd"
Settings="*res://src/core/settings.gd"
Content="*res://src/data/content_registry.gd"
Save="*res://src/core/save_game.gd"
Audio="*res://src/core/audio_director.gd"
Net="*res://src/net/net_service.gd"
Router="*res://src/core/scene_router.gd"
Game="*res://src/core/game_manager.gd"
Dev="*res://src/core/dev.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-mcp/plugin.cfg")

[internationalization]

locale/fallback="en"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
